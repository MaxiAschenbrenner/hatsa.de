---
import AppEntries from '../../components/AppEntries.astro';
import PostEntries from '../../components/PostEntries.astro';
import { getAppList, getPostList } from '../../i18n/content';
import { langPaths, localizePath, useTranslations, type Lang } from '../../i18n/ui';
import Base from '../../layouts/Base.astro';

export const getStaticPaths = langPaths;

const { lang } = Astro.props as { lang: Lang };
const t = useTranslations(lang);

const apps = await getAppList(lang);
const posts = (await getPostList(lang)).slice(0, 3);
---

<Base lang={lang}>
  <h2>{t('nav.apps')}</h2>
  <AppEntries apps={apps} lang={lang} />

  <h2>{t('home.latestPosts')}</h2>
  <PostEntries posts={posts} lang={lang} />
  <p><a href={localizePath(lang, '/blog/')}>{t('home.allPosts')}</a></p>
</Base>
