---
import PostEntries from '../../../components/PostEntries.astro';
import { getPostList } from '../../../i18n/content';
import { langPaths, useTranslations, type Lang } from '../../../i18n/ui';
import Base from '../../../layouts/Base.astro';

export const getStaticPaths = langPaths;

const { lang } = Astro.props as { lang: Lang };
const t = useTranslations(lang);
const posts = await getPostList(lang);
---

<Base lang={lang} title="Blog" description={t('blog.description')}>
  <h1>Blog</h1>
  <PostEntries posts={posts} lang={lang} />
</Base>
