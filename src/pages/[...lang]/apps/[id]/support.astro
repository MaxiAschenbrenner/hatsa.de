---
import { appPaths } from '../../../../i18n/content';
import { localizePath } from '../../../../i18n/ui';
import Base from '../../../../layouts/Base.astro';

export const getStaticPaths = appPaths;

const { lang, app } = Astro.props;
const { name, supportEmail } = app.data;
const text = {
  en: {
    description: `Help and contact for ${name}.`,
    contact: 'Questions, feedback or problems? Email me at',
    pending: 'Contact options coming soon.',
  },
  de: {
    description: `Hilfe und Kontakt zu ${name}.`,
    contact: 'Fragen, Feedback oder Probleme? Schreib mir an',
    pending: 'Kontaktmöglichkeiten folgen in Kürze.',
  },
}[lang];
---

<Base lang={lang} title={`${name} – Support`} description={text.description}>
  <p><a href={localizePath(lang, `/apps/${Astro.params.id}/`)}>← {name}</a></p>
  <h1>{name} – Support</h1>
  {supportEmail ? (
    <p>{text.contact} <a href={`mailto:${supportEmail}`}>{supportEmail}</a>.</p>
  ) : (
    <p>{text.pending}</p>
  )}
</Base>
