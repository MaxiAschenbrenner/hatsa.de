---
import AppEntries from '../../../components/AppEntries.astro';
import { getAppList } from '../../../i18n/content';
import { langPaths, useTranslations, type Lang } from '../../../i18n/ui';
import Base from '../../../layouts/Base.astro';

export const getStaticPaths = langPaths;

const { lang } = Astro.props as { lang: Lang };
const t = useTranslations(lang);
const apps = await getAppList(lang);
---

<Base lang={lang} title="Apps" description={t('apps.description')}>
  <h1>Apps</h1>
  <AppEntries apps={apps} lang={lang} />
</Base>
