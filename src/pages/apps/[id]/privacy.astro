---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';

export async function getStaticPaths() {
  const apps = await getCollection('apps');
  return apps.map((app) => ({ params: { id: app.id }, props: { app } }));
}

const { app } = Astro.props;
---

<Base title={`${app.data.name} – Datenschutz`} description={`Datenschutzerklärung für ${app.data.name}.`}>
  <p><a href={`/apps/${app.id}/`}>← {app.data.name}</a></p>
  <h1>Datenschutzerklärung für {app.data.name}</h1>
  <p>Die Datenschutzerklärung für {app.data.name} wird vor der Veröffentlichung der App hier bereitgestellt.</p>
</Base>
