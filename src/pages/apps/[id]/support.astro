---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';

export async function getStaticPaths() {
  const apps = await getCollection('apps');
  return apps.map((app) => ({ params: { id: app.id }, props: { app } }));
}

const { app } = Astro.props;
---

<Base title={`${app.data.name} – Support`} description={`Hilfe und Kontakt zu ${app.data.name}.`}>
  <p><a href={`/apps/${app.id}/`}>← {app.data.name}</a></p>
  <h1>{app.data.name} – Support</h1>
  {app.data.supportEmail ? (
    <p>Fragen, Feedback oder Probleme? Schreib mir an <a href={`mailto:${app.data.supportEmail}`}>{app.data.supportEmail}</a>.</p>
  ) : (
    <p>Kontaktmöglichkeiten folgen in Kürze.</p>
  )}
</Base>
