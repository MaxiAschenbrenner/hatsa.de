---
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';

export async function getStaticPaths() {
  const apps = await getCollection('apps');
  return apps.map((app) => ({ params: { id: app.id }, props: { app } }));
}

const { app } = Astro.props;
const { Content } = await render(app);
const statusLabel = {
  'in-entwicklung': 'In Entwicklung',
  beta: 'Beta',
  veroeffentlicht: 'Verfügbar',
}[app.data.status];
---

<Base title={app.data.name} description={app.data.tagline}>
  <h1>{app.data.name}</h1>
  <p><span class="badge">{statusLabel}</span></p>
  <p class="muted">{app.data.tagline}</p>

  {(app.data.appStoreUrl || app.data.playStoreUrl) && (
    <p>
      {app.data.appStoreUrl && <a href={app.data.appStoreUrl}>Im App Store laden</a>}
      {app.data.appStoreUrl && app.data.playStoreUrl && ' · '}
      {app.data.playStoreUrl && <a href={app.data.playStoreUrl}>Bei Google Play laden</a>}
    </p>
  )}

  <Content />

  <p>
    <a href={`/apps/${app.id}/support/`}>Support</a> ·
    <a href={`/apps/${app.id}/privacy/`}>Datenschutz</a>
  </p>
</Base>
