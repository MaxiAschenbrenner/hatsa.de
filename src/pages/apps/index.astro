---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const apps = (await getCollection('apps')).sort((a, b) => a.data.order - b.data.order);
---

<Base title="Apps" description="Alle Apps von hatsa.de.">
  <h1>Apps</h1>
  <ul class="cards">
    {apps.map((app) => (
      <li>
        <h3><a href={`/apps/${app.id}/`}>{app.data.name}</a></h3>
        <p class="muted">{app.data.tagline}</p>
      </li>
    ))}
  </ul>
</Base>
